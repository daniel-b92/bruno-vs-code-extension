// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "autoAttachChildProcesses": true,
            "env": { "BRUNO_YAML_SUPPORT": "true" },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/samples"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/client/dist/**/*.js*",
                "${workspaceRoot}/server/dist/**/*.js*"
            ],
            "preLaunchTask": "npm: compile"
        },
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "noDebug": true,
            "env": { "BRUNO_YAML_SUPPORT": "true" },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/samples"
            ],
            "preLaunchTask": "npm: compile"
        },
        {
            "name": "Run Extension (without feature toggles)",
            "type": "extensionHost",
            "request": "launch",
            "noDebug": true,
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/samples"
            ],
            "preLaunchTask": "npm: compile"
        },
        {
            "name": "Debug Extension With local TS plugin",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "env": { "BRUNO_YAML_SUPPORT": "true" },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/samples"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "npm: compileWithLocalTsPlugin"
        },
        {
            "name": "Run Extension With local TS plugin",
            "type": "extensionHost",
            "request": "launch",
            "noDebug": true,
            "runtimeExecutable": "${execPath}",
            "env": { "BRUNO_YAML_SUPPORT": "true" },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/samples"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "npm: compileWithLocalTsPlugin"
        }
    ]
}
