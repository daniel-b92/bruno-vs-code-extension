{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@global_shared": ["../shared/index.ts"],
            "@global_shared/*": ["../shared/*"]
        },
        "rootDir": ".",
        "outDir": "out",
        "allowJs": true,
        "types": ["node", "jest"]
    },
    "exclude": [
        "node_modules",
        "dist",
        "out",
        "jest.config.js",
        "webpack.config.js"
    ],
    "references": [{ "path": "../shared" }]
}
