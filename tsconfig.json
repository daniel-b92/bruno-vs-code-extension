{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2024",
        "lib": ["es2024"],
        "sourceMap": true,
        "strict": true,
        // Makes ts-jest only transpile the files instead of type-checking them for every Jest worker (which uses a lot of memory).
        // Types are checked via `npm run check-types` instead.
        "isolatedModules": true,
        "types": ["node"],

        "allowUnreachableCode": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true
    },
    "exclude": ["node_modules", ".vscode-test", "**/*.md"]
}
