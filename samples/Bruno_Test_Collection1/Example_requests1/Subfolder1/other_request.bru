meta {
  name: other_request
  type: http
  seq: 1
}

get {
  url: https://example.com/{{exe}}
  body: none
  auth: none
}

vars:post-response {
  asasas: ererer
}

script:pre-request {
  bru.setEnvVar("exe", "sdsd");
}

script:post-response {
  bru.setEnvVar("bli", "asasas");
  bru.getVar("asasas");
  bru.geVar("rtrtrtr");
}

tests {
  test("should be able to login", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.contain("example");
  });
}
