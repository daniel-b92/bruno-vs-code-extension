{
    "name": "bru-as-code",
    "displayName": "bru-as-code",
    "description": "Enables working with '.bru' files in a manner like working with code",
    "version": "1.5.0",
    "publisher": "daniel-b92",
    "private": true,
    "license": "MIT",
    "repository": "https://github.com/daniel-b92/bruno-vs-code-extension",
    "bugs": {
        "url": "https://github.com/daniel-b92/bruno-vs-code-extension/issues"
    },
    "engines": {
        "vscode": "^1.140.0"
    },
    "extensionDependencies": [
        "vscode.typescript-language-features"
    ],
    "categories": [
        "Testing",
        "Snippets",
        "Programming Languages",
        "Linters"
    ],
    "keywords": [
        "Bruno",
        "API Testing",
        "Test Automation",
        "Bruno CLI"
    ],
    "icon": "./icon.png",
    "activationEvents": [
        "workspaceContains:**/*.bru",
        "workspaceContains:**/opencollection.yml"
    ],
    "main": "./client/dist/extension",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "cd client && webpack --mode development && cd ../server && webpack --mode development && cd ..",
        "compileWithLocalTsPlugin": "cd tsPlugin && tsc --project tsconfig.json && mkdir -p ../node_modules/typescript-for-bruno && cp -r ./out/. ../node_modules/typescript-for-bruno && cd ../client && webpack --mode development && cd ../server && webpack --mode development && cd ..",
        "lint": "eslint \"**/*.ts\"",
        "check-types": "tsc -b client server",
        "watch": "cd client && webpack --mode development --watch",
        "package": "cd client && webpack --mode production --devtool hidden-source-map && cd ../server && webpack --mode production --devtool hidden-source-map && cd ..",
        "test-server": "jest --selectProjects server",
        "test-shared": "jest --selectProjects shared",
        "test-ts-plugin": "jest --selectProjects tsPlugin",
        "test": "jest",
        "test-syntaxes": "jest --selectProjects syntaxes",
        "generate-syntaxes": "jiti syntaxes/generation/generateGrammars.ts"
    },
    "dependencies": {
        "@zentryc5t/ts-plugin-for-bruno": "^3.0.3",
        "evt": "^2.5.9",
        "glob": "^13.0.1",
        "jsonc-parser": "^3.3.1",
        "prettier": "^3.9.9",
        "tree-kill": "^1.2.2",
        "uuid": "^14.0.2",
        "vscode-languageclient": "^10.1.2",
        "vscode-languageserver": "^10.1.2",
        "vscode-languageserver-textdocument": "^1.0.12",
        "vscode-uri": "^3.1.0",
        "watcher": "^2.3.1",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/chai": "^5.2.2",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.8.1",
        "eslint-import-resolver-typescript": "^4.3.0",
        "eslint-plugin-boundaries": "^7.2.0",
        "jest": "^30.4.2",
        "jiti": "^2.7.0",
        "process": "^0.11.10",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.3"
    },
    "contributes": {
        "configuration": {
            "title": "bru-as-code",
            "properties": {
                "bru-as-code.testRunEnvironments": {
                    "type": "object",
                    "description": "The configured environment per collection to use when executing tests via Bruno CLI. Can be configured when selecting the root folder in the collection explorer."
                },
                "bru-as-code.htmlReportPath": {
                    "type": "string",
                    "default": "",
                    "description": "The path for saving HTML test reports permanently. Can either be defined as an absolute path or relative to the collection root directory. If empty, no report is saved to the workspace (unless `bru-as-code.showHtmlReport` is set to `never`, the latest report is kept in the extension's own storage, so that it can be shown)."
                },
                "bru-as-code.showHtmlReport": {
                    "type": "string",
                    "enum": [
                        "always",
                        "onFailure",
                        "never"
                    ],
                    "enumDescriptions": [
                        "Show the HTML test report after every test run.",
                        "Only show the HTML test report for failed test runs.",
                        "Never show the HTML test report automatically."
                    ],
                    "default": "onFailure",
                    "markdownDescription": "When to show the HTML test report after running tests. The latest report can also be opened via the command *Show last HTML test report* (not available if set to *never* and no `#bru-as-code.htmlReportPath#` is configured)."
                },
                "bru-as-code.alwaysShowHtmlReport": {
                    "type": "boolean",
                    "default": false,
                    "markdownDeprecationMessage": "**Deprecated**: Use `#bru-as-code.showHtmlReport#` instead. `true` is treated as `always` as long as `showHtmlReport` is not set.",
                    "deprecationMessage": "Deprecated: Use 'bru-as-code.showHtmlReport' instead."
                },
                "bru-as-code.sandboxDeveloperMode": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Use the 'developer' Javascript sandbox for running tests via Bruno CLI. See option `--sandbox` in the [Bruno_docs](https://docs.usebruno.com/bru-cli/commandOptions) for further infos."
                },
                "bru-as-code.yamlCollectionSupport": {
                    "type": "boolean",
                    "default": false,
                    "tags": [
                        "preview"
                    ],
                    "markdownDescription": "**Preview:** Enable support for collections in the `yaml` format (`opencollection.yml`), including the collection explorer, test explorer and language features for `.yml` files in these collections. A window reload is required for changes to take effect."
                },
                "bru-as-code.suggestEnablingYamlCollectionSupport": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show a dialog suggesting to enable the setting `#bru-as-code.yamlCollectionSupport#` when a `yaml` collection is found in the workspace."
                },
                "bru-as-code.suggestCreatingTsConfigsForCollections": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show a dialog suggesting to create tsconfig files for collections (if not already existing) after every extension start."
                }
            }
        },
        "configurationDefaults": {
            "[bru]": {
                "editor.quickSuggestions": {
                    "other": "on",
                    "comments": "off",
                    "strings": "on"
                }
            }
        },
        "typescriptServerPlugins": [
            {
                "enableForWorkspaceTypeScriptVersions": true,
                "name": "@zentryc5t/ts-plugin-for-bruno",
                "languages": [
                    "bru",
                    "js",
                    "yaml"
                ]
            }
        ],
        "languages": [
            {
                "id": "bru",
                "extensions": [
                    ".bru"
                ],
                "aliases": [
                    "bru",
                    "bru"
                ],
                "configuration": "./client/src/languageFeatures/language-configuration.json"
            },
            {
                "id": "bru-graphql-block",
                "extensions": []
            }
        ],
        "grammars": [
            {
                "language": "bru",
                "scopeName": "source.bru",
                "path": "./syntaxes/bru.tmLanguage.json"
            },
            {
                "language": "bru-graphql-block",
                "scopeName": "source.graphql.bru",
                "path": "./syntaxes/graphql.json"
            },
            {
                "path": "./syntaxes/injection.json",
                "scopeName": "source.bruno.json-block.injection",
                "injectTo": [
                    "source.bru",
                    "source.yaml"
                ]
            },
            {
                "path": "./syntaxes/yaml-document.injection.json",
                "scopeName": "source.bruno.yaml-document.injection",
                "injectTo": [
                    "source.yaml"
                ]
            },
            {
                "path": "./syntaxes/yaml-sections.injection.json",
                "scopeName": "source.bruno.yaml-sections.injection",
                "injectTo": [
                    "source.yaml"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.html": "html",
                    "meta.embedded.block.markdown": "markdown",
                    "source.js": "javascript",
                    "source.css": "css"
                }
            },
            {
                "path": "./syntaxes/yaml-scripts.injection.json",
                "scopeName": "source.bruno.yaml-scripts.injection",
                "injectTo": [
                    "source.yaml"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.javascript": "javascript"
                }
            },
            {
                "path": "./syntaxes/yaml-bodies.injection.json",
                "scopeName": "source.bruno.yaml-bodies.injection",
                "injectTo": [
                    "source.yaml"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.json": "json",
                    "meta.embedded.block.xml": "xml",
                    "meta.embedded.block.html": "html",
                    "source.js": "javascript",
                    "source.css": "css",
                    "meta.embedded.block.graphql": "bru-graphql-block"
                }
            },
            {
                "path": "./syntaxes/yaml-docs.injection.json",
                "scopeName": "source.bruno.yaml-docs.injection",
                "injectTo": [
                    "source.yaml"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.markdown": "markdown"
                }
            },
            {
                "path": "./syntaxes/yaml-app.injection.json",
                "scopeName": "source.bruno.yaml-app.injection",
                "injectTo": [
                    "source.yaml"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.html": "html",
                    "source.js": "javascript",
                    "source.css": "css"
                }
            }
        ],
        "commands": [
            {
                "command": "bruAsCode.showLastHtmlReport",
                "title": "Show last HTML test report",
                "category": "Bru-as-Code"
            },
            {
                "command": "brunoCollectionsView.refresh",
                "title": "Refresh collection explorer",
                "category": "Bru-as-Code",
                "icon": "$(extensions-refresh)"
            },
            {
                "command": "brunoCollectionsView.deleteItem",
                "title": "Delete",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.duplicateFile",
                "title": "Duplicate",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.duplicateFolder",
                "title": "Duplicate",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.renameItem",
                "title": "Rename",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.createRequestFile",
                "title": "Create request file",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.createEmptyFile",
                "title": "Create empty file",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.createFolder",
                "title": "Create folder",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.copyFile",
                "title": "Copy file",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.pasteFile",
                "title": "Paste",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView && BruAsCode.canPasteFile"
            },
            {
                "command": "brunoCollectionsView.startTestRun",
                "title": "Start test run directly",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.openDialogForTestRun",
                "title": "Open test run dialog",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.openInNewTabgroup",
                "title": "Open to the side",
                "category": "Bru-as-Code",
                "enablement": "view == brunoCollectionsView"
            },
            {
                "command": "brunoCollectionsView.selectEnvironmentForCollection",
                "title": "Select environment",
                "category": "Bru-as-Code"
            },
            {
                "command": "bruAsCode.restartLanguageServer",
                "title": "Restart language server",
                "category": "Bru-as-Code"
            },
            {
                "command": "bruAsCode.toggleLineComment",
                "title": "Toggle line comment",
                "category": "Bru-as-Code"
            },
            {
                "command": "bruAsCode.addLineComment",
                "title": "Add line comment",
                "category": "Bru-as-Code"
            },
            {
                "command": "bruAsCode.removeLineComment",
                "title": "Remove line comment",
                "category": "Bru-as-Code"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "brunoCollectionsView",
                    "name": "Bruno Collections",
                    "icon": ""
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "brunoCollectionsView.refresh",
                    "when": "view == brunoCollectionsView",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "brunoCollectionsView.openInNewTabgroup",
                    "when": "view == brunoCollectionsView && viewItem == file",
                    "group": "navigation@1"
                },
                {
                    "command": "brunoCollectionsView.createRequestFile",
                    "when": "view == brunoCollectionsView && (viewItem == folder || viewItem == collectionRoot)",
                    "group": "crud@1"
                },
                {
                    "command": "brunoCollectionsView.createEmptyFile",
                    "when": "view == brunoCollectionsView && (viewItem == folder || viewItem == collectionRoot)",
                    "group": "crud@5"
                },
                {
                    "command": "brunoCollectionsView.createFolder",
                    "when": "view == brunoCollectionsView && (viewItem == folder || viewItem == collectionRoot)",
                    "group": "crud@10"
                },
                {
                    "command": "brunoCollectionsView.renameItem",
                    "when": "view == brunoCollectionsView",
                    "group": "crud@20"
                },
                {
                    "command": "brunoCollectionsView.duplicateFile",
                    "when": "view == brunoCollectionsView && viewItem==file",
                    "group": "crud@30"
                },
                {
                    "command": "brunoCollectionsView.duplicateFolder",
                    "when": "view == brunoCollectionsView && viewItem == folder",
                    "group": "crud@35"
                },
                {
                    "command": "brunoCollectionsView.copyFile",
                    "when": "view == brunoCollectionsView && viewItem==file",
                    "group": "crud@37"
                },
                {
                    "command": "brunoCollectionsView.pasteFile",
                    "when": "view == brunoCollectionsView",
                    "group": "crud@38"
                },
                {
                    "command": "brunoCollectionsView.deleteItem",
                    "when": "view == brunoCollectionsView",
                    "group": "crud@40"
                },
                {
                    "command": "brunoCollectionsView.startTestRun",
                    "when": "view == brunoCollectionsView",
                    "group": "execution@1"
                },
                {
                    "command": "brunoCollectionsView.openDialogForTestRun",
                    "when": "view == brunoCollectionsView",
                    "group": "execution@5"
                }
            ],
            "commandPalette": [
                {
                    "command": "bruAsCode.toggleLineComment",
                    "when": "false"
                },
                {
                    "command": "bruAsCode.addLineComment",
                    "when": "false"
                },
                {
                    "command": "bruAsCode.removeLineComment",
                    "when": "false"
                }
            ]
        },
        "keybindings": [
            {
                "command": "bruAsCode.toggleLineComment",
                "key": "ctrl+/",
                "mac": "cmd+/",
                "when": "editorTextFocus && !editorReadonly && editorLangId == yaml && bruAsCode.yamlCollectionSupport"
            },
            {
                "command": "bruAsCode.addLineComment",
                "key": "ctrl+k ctrl+c",
                "mac": "cmd+k cmd+c",
                "when": "editorTextFocus && !editorReadonly && editorLangId == yaml && bruAsCode.yamlCollectionSupport"
            },
            {
                "command": "bruAsCode.removeLineComment",
                "key": "ctrl+k ctrl+u",
                "mac": "cmd+k cmd+u",
                "when": "editorTextFocus && !editorReadonly && editorLangId == yaml && bruAsCode.yamlCollectionSupport"
            }
        ]
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true
    }
}
